<?xml version="1.0" encoding="UTF-8"?>
<style-scheme version="1.0" name="Dark Modern">
  <style name="Text" foreground="#d4d4d4" background="#1f1f1f"/>
  <style name="Link" foreground="#4daafc" underlineStyle="SingleUnderline"/>
  <style name="Selection" background="#264f78"/>
  <style name="LineNumber" foreground="#6e7681" background="#1f1f1f"/>
  <style name="CurrentLine" background="#282828"/>
  <style name="CurrentLineNumber" foreground="#cccccc"/>
  <style name="SearchResult" background="#613214"/>
  <style name="SearchResultAlt1" background="#264f78"/>
  <style name="SearchResultAlt2" background="#4b1818"/>
  <style name="SearchScope" background="#2a2a20"/>
  <style name="Parentheses" foreground="#ffd700" background="#3a3d41"/>
  <style name="ParenthesesMismatch" foreground="#f14c4c" background="#4b1818"/>
  <style name="AutoComplete" background="#3a3d41"/>
  <style name="Occurrences" background="#3a3d41"/>
  <style name="Occurrences.Unused" foreground="#8b8b8b" underlineColor="#8b8b8b" underlineStyle="SingleUnderline"/>
  <style name="Occurrences.Rename" background="#4b1818"/>
  <style name="VisualWhitespace" foreground="#3b3b3b"/>
  <style name="DisabledCode" foreground="#7f7f7f"/>

  <style name="Keyword" foreground="#569cd6"/>
  <style name="PrimitiveType" foreground="#569cd6"/>
  <style name="Preprocessor" foreground="#c586c0"/>
  <style name="Comment" foreground="#6a9955"/>
  <style name="Doxygen.Comment" foreground="#6a9955"/>
  <style name="Doxygen.Tag" foreground="#569cd6"/>
  <style name="String" foreground="#ce9178"/>
  <style name="Number" foreground="#b5cea8"/>
  <style name="Type" foreground="#4ec9b0"/>
  <style name="Function" foreground="#dcdcaa"/>
  <style name="VirtualMethod" foreground="#dcdcaa" italic="true"/>
  <style name="Declaration"/>
  <style name="Field" foreground="#9cdcfe"/>
  <style name="Local" foreground="#9cdcfe"/>
  <style name="Global" foreground="#9cdcfe"/>
  <style name="Static" foreground="#4fc1ff"/>
  <style name="OutputArgument" foreground="#9cdcfe" italic="true"/>
  <style name="Label" foreground="#c8c8c8"/>
  <style name="Operator" foreground="#cccccc"/>
  <style name="Overloaded Operator" foreground="#dcdcaa"/>
  <style name="Punctuation" foreground="#cccccc"/>

  <style name="QmlTypeId" foreground="#4ec9b0"/>
  <style name="QmlLocalId" foreground="#9cdcfe"/>
  <style name="QmlExternalId" foreground="#9cdcfe"/>
  <style name="QmlRootObjectProperty" foreground="#9cdcfe"/>
  <style name="QmlScopeObjectProperty" foreground="#9cdcfe"/>
  <style name="QmlExternalObjectProperty" foreground="#9cdcfe"/>
  <style name="QmlStateName" foreground="#ce9178"/>
  <style name="Binding" foreground="#9cdcfe"/>
  <style name="JsScopeVar" foreground="#9cdcfe"/>
  <style name="JsImportVar" foreground="#4ec9b0"/>
  <style name="JsGlobalVar" foreground="#4fc1ff"/>

  <style name="Warning" underlineColor="#cca700" underlineStyle="WaveUnderline"/>
  <style name="WarningContext" underlineColor="#cca700" underlineStyle="DotLine"/>
  <style name="Error" underlineColor="#f14c4c" underlineStyle="WaveUnderline"/>
  <style name="ErrorContext" underlineColor="#f14c4c" underlineStyle="DotLine"/>

  <style name="AddedLine" foreground="#81b88b"/>
  <style name="RemovedLine" foreground="#c74e39"/>
  <style name="DiffFile" foreground="#569cd6"/>
  <style name="DiffLocation" foreground="#c586c0"/>
  <style name="DiffFileLine" foreground="#cccccc" background="#2b2b2b"/>
  <style name="DiffContextLine" foreground="#9d9d9d" background="#252526"/>
  <style name="DiffSourceLine" background="#4b1818"/>
  <style name="DiffSourceChar" background="#6f1313"/>
  <style name="DiffDestLine" background="#373d29"/>
  <style name="DiffDestChar" background="#4b5632"/>
  <style name="LogChangeLine" foreground="#c586c0"/>
  <style name="LogAuthorName" foreground="#9cdcfe"/>
  <style name="LogCommitDate" foreground="#b5cea8"/>
  <style name="LogCommitHash" foreground="#dcdcaa"/>
  <style name="LogCommitSubject" foreground="#cccccc"/>
  <style name="LogDecoration" foreground="#4ec9b0"/>
</style-scheme>
