<?xml version="1.0" encoding="UTF-8"?>
<style-scheme version="1.0" name="Light Modern">
  <style name="Text" foreground="#3b3b3b" background="#ffffff"/>
  <style name="Link" foreground="#005fb8" underlineStyle="SingleUnderline"/>
  <style name="Selection" background="#add6ff"/>
  <style name="LineNumber" foreground="#6e7681" background="#ffffff"/>
  <style name="CurrentLine" background="#f3f3f3"/>
  <style name="CurrentLineNumber" foreground="#171184"/>
  <style name="SearchResult" background="#f8c9a6"/>
  <style name="SearchResultAlt1" background="#add6ff"/>
  <style name="SearchResultAlt2" background="#ffd7d5"/>
  <style name="SearchScope" background="#fafae0"/>
  <style name="Parentheses" foreground="#3b3b3b" background="#d7e8d3"/>
  <style name="ParenthesesMismatch" foreground="#e51400" background="#ffd7d5"/>
  <style name="AutoComplete" background="#e5ebf1"/>
  <style name="Occurrences" background="#e0e0e0"/>
  <style name="Occurrences.Unused" foreground="#8b8b8b" underlineColor="#8b8b8b" underlineStyle="SingleUnderline"/>
  <style name="Occurrences.Rename" background="#ffd7d5"/>
  <style name="VisualWhitespace" foreground="#cccccc"/>
  <style name="DisabledCode" foreground="#9e9e9e"/>

  <style name="Keyword" foreground="#0000ff"/>
  <style name="PrimitiveType" foreground="#0000ff"/>
  <style name="Preprocessor" foreground="#af00db"/>
  <style name="Comment" foreground="#008000"/>
  <style name="Doxygen.Comment" foreground="#008000"/>
  <style name="Doxygen.Tag" foreground="#0000ff"/>
  <style name="String" foreground="#a31515"/>
  <style name="Number" foreground="#098658"/>
  <style name="Type" foreground="#267f99"/>
  <style name="Function" foreground="#795e26"/>
  <style name="VirtualMethod" foreground="#795e26" italic="true"/>
  <style name="Declaration"/>
  <style name="Field" foreground="#001080"/>
  <style name="Local" foreground="#001080"/>
  <style name="Global" foreground="#001080"/>
  <style name="Static" foreground="#0070c1"/>
  <style name="OutputArgument" foreground="#001080" italic="true"/>
  <style name="Label" foreground="#3b3b3b"/>
  <style name="Operator" foreground="#3b3b3b"/>
  <style name="Overloaded Operator" foreground="#795e26"/>
  <style name="Punctuation" foreground="#3b3b3b"/>

  <style name="QmlTypeId" foreground="#267f99"/>
  <style name="QmlLocalId" foreground="#001080"/>
  <style name="QmlExternalId" foreground="#001080"/>
  <style name="QmlRootObjectProperty" foreground="#001080"/>
  <style name="QmlScopeObjectProperty" foreground="#001080"/>
  <style name="QmlExternalObjectProperty" foreground="#001080"/>
  <style name="QmlStateName" foreground="#a31515"/>
  <style name="Binding" foreground="#001080"/>
  <style name="JsScopeVar" foreground="#001080"/>
  <style name="JsImportVar" foreground="#267f99"/>
  <style name="JsGlobalVar" foreground="#0070c1"/>

  <style name="Warning" underlineColor="#bf8803" underlineStyle="WaveUnderline"/>
  <style name="WarningContext" underlineColor="#bf8803" underlineStyle="DotLine"/>
  <style name="Error" underlineColor="#e51400" underlineStyle="WaveUnderline"/>
  <style name="ErrorContext" underlineColor="#e51400" underlineStyle="DotLine"/>

  <style name="AddedLine" foreground="#587c0c"/>
  <style name="RemovedLine" foreground="#ad0707"/>
  <style name="DiffFile" foreground="#0000ff"/>
  <style name="DiffLocation" foreground="#af00db"/>
  <style name="DiffFileLine" foreground="#3b3b3b" background="#e5e5e5"/>
  <style name="DiffContextLine" foreground="#6e7681" background="#f3f3f3"/>
  <style name="DiffSourceLine" background="#ffd7d5"/>
  <style name="DiffSourceChar" background="#ffb3ad"/>
  <style name="DiffDestLine" background="#dbf3d5"/>
  <style name="DiffDestChar" background="#b4e6a8"/>
  <style name="LogChangeLine" foreground="#af00db"/>
  <style name="LogAuthorName" foreground="#001080"/>
  <style name="LogCommitDate" foreground="#098658"/>
  <style name="LogCommitHash" foreground="#795e26"/>
  <style name="LogCommitSubject" foreground="#3b3b3b"/>
  <style name="LogDecoration" foreground="#267f99"/>
</style-scheme>
